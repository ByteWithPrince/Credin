{
  "name": "credin-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "test:backend": "python -m pytest backend/tests -v"
  }
}
